WebSocketsServer webSocket = WebSocketsServer(5000);

bool conexionPCEstablecida = false;

uint32_t tiempoUltimoEnvioPC = 0;

const uint32_t intervaloEnvioPC_ms = 1000;


#define directionPin 26
#define stepPin 25

#define switchLeft 19
#define switchRight 18

#define relayPin 12

#define RELAY_ON  LOW
#define RELAY_OFF HIGH


#define SDA_PIN 21
#define SCL_PIN 22

const uint8_t MPU_ADDRESS = 0x68;


const int pinSensor = 34;

const int muestrasPresion = 100;

const float factor_mmHg_por_V = 35.717;
const float pendiente = 1.0627;
const float intercepto = -0.0692;


const float toleranciaPresion = 0.50;


const bool izquierdaAumentaPresion = true;


const uint32_t intervaloCambioStep_us = 1000;

enum EstadoMotor {

  MOTOR_DETENIDO,

  MOTOR_DERECHA,

  MOTOR_IZQUIERDA

};

EstadoMotor estadoMotor = MOTOR_DETENIDO;

bool estadoStep = LOW;

uint32_t tiempoUltimoStep = 0;


uint32_t sumaPresion_mV = 0;

int contadorMuestrasPresion = 0;

uint32_t tiempoUltimaMuestraPresion = 0;

const uint32_t intervaloMuestraPresion_us = 2000;

float voltajeESP32 = 0;

float voltajeCorregido = 0;

float presion_mmHg = 0;

bool presionDisponible = false;


float temperaturaPaciente = 36.5;

bool temperaturaRecibida = false;

float anguloEstable = 0.0;

float PICObjetivo = 0;


float picInicialDrenaje = 0;

uint32_t tiempoInicioDrenaje = 0;

const uint32_t deltaT_Drenaje_ms = 5000;

float tasaDrenaje_ml_h = 0.0;


float RateRoll = 0;

float RatePitch = 0;

float RateYaw = 0;


const float RateCalibrationRoll =
  -1.789807f;

const float RateCalibrationPitch =
  0.121160f;

const float RateCalibrationYaw =
  -4.624726f;


const float AngleCalibrationRoll =
  -0.576532f;

const float AngleCalibrationPitch =
  -1.596584f;


float AccX = 0;

float AccY = 0;

float AccZ = 0;

float AngleRoll = 0;

float AnglePitch = 0;


float KalmanAngleRoll = 0;

float KalmanUncertaintyAngleRoll = 4;

float KalmanAnglePitch = 0;

float KalmanUncertaintyAnglePitch = 4;

const float tiempoMuestreoKalman = 0.004;



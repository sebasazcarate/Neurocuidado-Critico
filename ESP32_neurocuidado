// =====================================================
// FUNCIONES MPU6050
// =====================================================
bool escribirRegistroMPU(uint8_t registro, uint8_t valor) {
  Wire.beginTransmission(MPU_ADDRESS);
  Wire.write(registro);
  Wire.write(valor);
  return Wire.endTransmission() == 0;
}

bool configurarMPU6050() {
  if (!escribirRegistroMPU(0x6B, 0x00)) return false;
  delay(100);
  if (!escribirRegistroMPU(0x19, 0x00)) return false;
  if (!escribirRegistroMPU(0x1A, 0x05)) return false;
  if (!escribirRegistroMPU(0x1C, 0x10)) return false; // ±8 g
  if (!escribirRegistroMPU(0x1B, 0x08)) return false; // ±500 °/s
  return true;
}

bool leerMPU6050() {
  Wire.beginTransmission(MPU_ADDRESS);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(MPU_ADDRESS, (uint8_t)14) != 14) return false;

  int16_t AccXLSB = ((int16_t)Wire.read() << 8) | Wire.read();
  int16_t AccYLSB = ((int16_t)Wire.read() << 8) | Wire.read();
  int16_t AccZLSB = ((int16_t)Wire.read() << 8) | Wire.read();
  Wire.read(); Wire.read(); // Descartar Temperatura
  int16_t GyroX = ((int16_t)Wire.read() << 8) | Wire.read();
  Wire.read(); Wire.read(); // Descartar Y
  Wire.read(); Wire.read(); // Descartar Z

  AccX = (float)AccXLSB / 4096.0;
  AccY = (float)AccYLSB / 4096.0;
  AccZ = (float)AccZLSB / 4096.0;
  RateRoll = (float)GyroX / 65.5;
  AngleRoll = atan2(AccY, sqrt(AccX * AccX + AccZ * AccZ)) * 180.0 / PI;

  return true;
}

void kalman_1d(float &KalmanState, float &KalmanUncertainty, float KalmanInput, float KalmanMeasurement, float dt) {
  KalmanState = KalmanState + dt * KalmanInput;
  KalmanUncertainty = KalmanUncertainty + dt * dt * 16.0;
  float KalmanGain = KalmanUncertainty / (KalmanUncertainty + 9.0);
  KalmanState = KalmanState + KalmanGain * (KalmanMeasurement - KalmanState);
  KalmanUncertainty = (1.0 - KalmanGain) * KalmanUncertainty;
}

void actualizarMPU6050() {
  uint32_t ahora = micros();
  if (ahora - tiempoUltimoMPU < intervaloMPU_us) return;
  float dt = (ahora - tiempoUltimoMPU) / 1000000.0f;
  tiempoUltimoMPU = ahora;

  if (!leerMPU6050()) return;

  RateRoll -= RateCalibrationRoll;
  AngleRoll -= AngleCalibrationRoll;
  kalman_1d(KalmanAngleRoll, KalmanUncertaintyAngleRoll, RateRoll, AngleRoll, dt);
}

// =====================================================
// MATEMÁTICAS DEL MODELO
// =====================================================
float calcularPICAngulo(float angulo) {
  if (angulo < 30.0) return 20.0;
  else if (angulo < 60.0) return 25.0 - (angulo / 6.0);
  else return 15.0;
}

float calcularDeltaPICT(float temperatura) {
  if (temperatura >= 34.5 && temperatura < 36.5) return 36.5 - temperatura;
  else if (temperatura >= 36.5 && temperatura <= 37.5) return 0.0;
  else if (temperatura > 37.5 && temperatura <= 39.0) return 3.0 * (temperatura - 37.5);
  return 0.0;
}

float convertirDeltaPICAvolumen(float deltaPIC) {
  // Ecuación: ΔV = 0.0106(ΔPIC)^2 + 0.0252(ΔPIC) + 0.1348
  return (0.0106 * deltaPIC * deltaPIC) + (0.0252 * deltaPIC) + 0.1348;
}

float calcularPICFinal(float picInicial, float drenaje) {
  float picD0 = 0.9890 * picInicial + 0.8873;
  float picD20 = 0.6180 * picInicial - 2.1676;
  float picMayor20 = 0.6372 * picInicial - 4.4962;
  if (picMayor20 < 0) picMayor20 = 0;

  if (drenaje <= 10) return picD0;
  if (drenaje < 25.0) {
    float factor = drenaje / 20.0;
    return picD0 + factor * (picD20 - picD0);
  }
  if (drenaje <= 25.01) return picD20;
  return picMayor20;
}

// =====================================================
// LECTURA PRESIÓN ACTUALIZADA (POR PARTES)
// =====================================================
float leerPIC() {
  uint32_t suma_mV = 0;
  for (int i = 0; i < muestrasPresion; i++) {
    suma_mV += analogReadMilliVolts(pinSensor);
  }
  float promedio_mV = suma_mV / (float)muestrasPresion;
  float voltajeESP32 = promedio_mV / 1000.0;

  float presionCalculada = 0.0;

  // Función a tramos según la curva de calibración final
  if (voltajeESP32 < 0.15205) {
    presionCalculada = 503.0092 * voltajeESP32 - 66.4691;
  } else {
    presionCalculada = 155.2195 * voltajeESP32 - 13.5867;
  }

  if (presionCalculada < 0) presionCalculada = 0;

  return presionCalculada;
}

void actualizarPIC() {
  if (millis() - ultimaLecturaPIC < intervaloLecturaPIC_ms) return;
  ultimaLecturaPIC = millis();
  presionActual = leerPIC();
  nuevaPICDisponible = true;
}

// =====================================================
// CONTROL MOTOR Y HARDWARE
// =====================================================
void detenerMotor() {
  estadoMotor = MOTOR_DETENIDO;
  digitalWrite(stepPin, LOW);
  estadoStep = LOW;
  // digitalWrite(relayPin, RELAY_OFF); // <-- COMENTADO PARA EVITAR EL CASTAÑEO
}

void aumentarPresion() {
  digitalWrite(relayPin, RELAY_OFF);
  if (digitalRead(switchLeft) == LOW) {
    detenerMotor();
    return;
  }
  estadoMotor = MOTOR_AUMENTANDO;
  digitalWrite(directionPin, DIR_AUMENTAR);
}

void disminuirPresion() {
  if (digitalRead(switchRight) == LOW) {
    detenerMotor();
    return;
  }
  estadoMotor = MOTOR_DISMINUYENDO;
  digitalWrite(directionPin, DIR_DISMINUIR);
  digitalWrite(relayPin, RELAY_ON);
}

void generarPasosMotor() {
  if (estadoMotor == MOTOR_DETENIDO) return;
  uint32_t ahora = micros();
  if (ahora - tiempoUltimoStep >= intervaloStep_us) {
    tiempoUltimoStep = ahora;
    estadoStep = !estadoStep;
    digitalWrite(stepPin, estadoStep);
  }
}

void verificarSwitches() {
  if (estadoMotor == MOTOR_AUMENTANDO && digitalRead(switchLeft) == LOW) {
    detenerMotor();
    digitalWrite(relayPin, RELAY_OFF); // <-- AÑADIDO: Seguridad extra
  }
  if (estadoMotor == MOTOR_DISMINUYENDO && digitalRead(switchRight) == LOW) {
    detenerMotor();
    digitalWrite(relayPin, RELAY_OFF); // <-- AÑADIDO: Seguridad extra
  }
}

// =====================================================
// RUTINAS DE REINICIO Y RETORNO
// =====================================================
void reiniciarEscenario() {
  detenerMotor();
  digitalWrite(relayPin, RELAY_OFF); // <-- AÑADIDO: Apagado seguro al reiniciar
  estadoSistema = ESPERANDO_TEMPERATURA;
  temperaturaPaciente = 0.0;

  AccX = 0.0; AccY = 0.0; AccZ = 0.0;
  RateRoll = 0.0; AngleRoll = 0.0;
  KalmanAngleRoll = 0.0; KalmanUncertaintyAngleRoll = 4.0;
  anguloEstable = 0.0; tiempoUltimoMPU = 0; tiempoInicioMedicion = 0;

  PICAngulo = 0.0; deltaPICT = 0.0; PICObjetivo = 0.0;
  presionActual = 0.0; ultimaLecturaPIC = 0; nuevaPICDisponible = false;

  tiempoInicioDrenaje = 0; picInicialDrenaje = 0.0; picFinalDrenajeMedida = 0.0;
  deltaPICDrenaje = 0.0; volumenDrenado_mL = 0.0; drenaje_mL_h = 0.0; drenajeCalculado = false;

  PICFinal = 0.0; PICReferenciaFinal = 0.0; ultimoCambioPICFinal = 0;

  estadoMotor = MOTOR_DETENIDO; estadoStep = LOW; tiempoUltimoStep = 0;
  banderaFinalEnviada = false; ultimoEnvioPIC = 0; ultimaImpresionPIC = 0;

  Serial.println("\n================================");
  Serial.println("SISTEMA REINICIADO");
  Serial.println("Estado: ESPERANDO_TEMPERATURA");
  Serial.println("Cliente WebSocket permanece conectado");
  Serial.println("================================");
}

void iniciarRetornoInicio() {
  detenerMotor();
  listoParaNuevaSesion = false; // Bloquea la recepción de nuevas temperaturas

  Serial.println("\n================================");
  Serial.println("FINALIZACION RECIBIDA DESDE HTML");
  Serial.println("Iniciando retorno del motor...");

  if (digitalRead(switchRight) == LOW) {
    Serial.println("switchRight ya esta activado. No es necesario mover el motor.");
    Serial.println("================================");
    listoParaNuevaSesion = true; // Libera la bandera
    reiniciarEscenario();
    return;
  }

  digitalWrite(directionPin, DIR_DISMINUIR);
  digitalWrite(relayPin, RELAY_ON);

  estadoMotor = MOTOR_DISMINUYENDO;
  estadoStep = LOW;
  digitalWrite(stepPin, LOW);
  tiempoUltimoStep = micros();
  estadoSistema = RETORNANDO_A_INICIO;

  Serial.println("Direccion: DISMINUIR");
  Serial.println("Rele: ENCENDIDO");
  Serial.println("Motor moviendose hacia switchRight...");
  Serial.println("================================");
}

// =====================================================
// WEBSOCKET: ENVIAR DATOS
// =====================================================
void enviarBanderaFinal() {
  if (banderaFinalEnviada) return;
  StaticJsonDocument<350> doc;

  doc["FINALIZAR"] = true;
  doc["PIC"] = presionActual;
  doc["PIC_INICIAL"] = picInicialDrenaje;
  doc["DELTA_PIC"] = deltaPICDrenaje;
  doc["VOLUMEN_DRENADO"] = volumenDrenado_mL;
  doc["DRENAJE"] = drenaje_mL_h;
  doc["PIC_FINAL"] = PICFinal;
  doc["ANGULO"] = anguloEstable;
  doc["TEMPERATURA"] = temperaturaPaciente;

  String mensaje;
  serializeJson(doc, mensaje);
  webSocket.broadcastTXT(mensaje);
  banderaFinalEnviada = true;

  Serial.println("\n================================");
  Serial.println("BANDERA FINAL ENVIADA AL HTML");
  Serial.println("================================");
}

void transmitirDatos() {
  if (millis() - ultimoEnvioPIC < intervaloEnvioPIC_ms) return;
  ultimoEnvioPIC = millis();

  StaticJsonDocument<250> doc;
  doc["PIC"] = presionActual;
  if (drenajeCalculado) {
    doc["DRENAJE"] = drenaje_mL_h;
    doc["PIC_FINAL"] = PICFinal;
  }

  String mensaje;
  serializeJson(doc, mensaje);
  webSocket.broadcastTXT(mensaje);
}

// =====================================================
// WEBSOCKET: RECIBIR EVENTOS
// =====================================================
void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  switch (type) {
    case WStype_CONNECTED:
      Serial.println("Cliente conectado");
      break;

    case WStype_DISCONNECTED:
      Serial.println("Cliente desconectado");
      break;

    case WStype_TEXT:
    {
      StaticJsonDocument<200> doc;
      DeserializationError error = deserializeJson(doc, payload, length);
      if (error) { Serial.println("Error leyendo JSON"); return; }

      // 1. RECIBIR ORDEN DE ABORTO
      if (doc.containsKey("FINALIZAR_ESCENARIO") && doc["FINALIZAR_ESCENARIO"] == true) {
        iniciarRetornoInicio();
        return;
      }

      // 2. RECIBIR NUEVA TEMPERATURA
      if (doc.containsKey("TEMPERATURA")) {

        // --- AQUÍ ESTÁ TU BANDERA DE SEGURIDAD ---
        if (!listoParaNuevaSesion) {
          Serial.println("\n[SEGURIDAD] Denegado: Esperando que el motor toque el switch inicial.");

          // NUEVO: Le avisamos a la interfaz web que estamos ocupados
          webSocket.sendTXT(num, "{\"ALERTA\":\"OCUPADO\"}");

          return; // Abortamos el proceso
        }
        if (estadoSistema == ESPERANDO_TEMPERATURA) {
          temperaturaPaciente = doc["TEMPERATURA"];
          banderaFinalEnviada = false;
          drenajeCalculado = false;

          Serial.print("\nTemperatura recibida: ");
          Serial.print(temperaturaPaciente, 2); Serial.println(" °C");

          KalmanAngleRoll = 0.0;
          KalmanUncertaintyAngleRoll = 4.0;
          tiempoInicioMedicion = millis();
          tiempoUltimoMPU = micros();

          estadoSistema = MIDIENDO_ANGULO;
          Serial.println("\nMidiendo Roll durante 15 segundos...");
        }
      }
      break;
    }
    default:
      break;
  }
}

// =====================================================
// MANEJO DE ESTADOS Y CONTROL
// =====================================================
void controlarPIC() {
  if (presionActual > PICObjetivo + toleranciaPIC) { disminuirPresion(); return; }
  if (presionActual < PICObjetivo - toleranciaPIC) { aumentarPresion(); return; }

  detenerMotor();
  digitalWrite(relayPin, RELAY_OFF);

  Serial.println("\n================================");
  Serial.println("PIC OBJETIVO ALCANZADA");
  Serial.print("PIC objetivo: "); Serial.print(PICObjetivo, 2); Serial.println(" mmHg");
  Serial.print("PIC actual: "); Serial.print(presionActual, 2); Serial.println(" mmHg");
  Serial.println("Rele: APAGADO");
  Serial.println("================================");

  iniciarMedicionDrenaje();
}

void iniciarMedicionDrenaje() {
  detenerMotor();
  picInicialDrenaje = presionActual;
  tiempoInicioDrenaje = millis();

  deltaPICDrenaje = 0.0; volumenDrenado_mL = 0.0; drenaje_mL_h = 0.0;
  drenajeCalculado = false; banderaFinalEnviada = false;

  Serial.println("\n================================");
  Serial.println("INICIO MEDICION DE DRENAJE");
  Serial.print("PIC inicial: "); Serial.print(picInicialDrenaje, 2); Serial.println(" mmHg");
  Serial.println("Duracion: 3 minutos");
  Serial.println("================================");

  estadoSistema = MIDIENDO_DRENAJE;
}

void finalizarMedicionDrenaje() {
  presionActual = leerPIC();
  picFinalDrenajeMedida = presionActual;

  deltaPICDrenaje = picInicialDrenaje - picFinalDrenajeMedida;
  if (deltaPICDrenaje < 0) deltaPICDrenaje = 0;

  volumenDrenado_mL = convertirDeltaPICAvolumen(deltaPICDrenaje);
  drenaje_mL_h = volumenDrenado_mL * 20.0; // 3 minutos = factor de 20
  PICFinal = calcularPICFinal(picInicialDrenaje, drenaje_mL_h);

  PICReferenciaFinal = presionActual;
  ultimoCambioPICFinal = millis();
  drenajeCalculado = true;

  Serial.println("\n================================");
  Serial.println("RESULTADO DEL DRENAJE");
  Serial.print("PIC inicial: "); Serial.print(picInicialDrenaje, 2); Serial.println(" mmHg");
  Serial.print("PIC despues de 3 min: "); Serial.print(picFinalDrenajeMedida, 2); Serial.println(" mmHg");
  Serial.print("Delta PIC: "); Serial.print(deltaPICDrenaje, 2); Serial.println(" mmHg");
  Serial.print("Volumen drenado: "); Serial.print(volumenDrenado_mL, 2); Serial.println(" mL");
  Serial.print("Drenaje: "); Serial.print(drenaje_mL_h, 2); Serial.println(" mL/h");
  Serial.print("PIC FINAL: "); Serial.print(PICFinal, 2); Serial.println(" mmHg");
  Serial.println("================================");

  enviarBanderaFinal();
  estadoSistema = AJUSTANDO_PIC_FINAL;
}

void actualizarReferenciaPICFinal() {
  if (millis() - ultimoCambioPICFinal < intervaloCambioPICFinal_ms) return;
  ultimoCambioPICFinal = millis();

  if (PICReferenciaFinal < PICFinal) {
    PICReferenciaFinal += pasoPICFinal;
    if (PICReferenciaFinal > PICFinal) PICReferenciaFinal = PICFinal;
  } else if (PICReferenciaFinal > PICFinal) {
    PICReferenciaFinal -= pasoPICFinal;
    if (PICReferenciaFinal < PICFinal) PICReferenciaFinal = PICFinal;
  }
}

void controlarPICFinal() {
  if (presionActual > PICReferenciaFinal + toleranciaPIC) { disminuirPresion(); return; }
  if (presionActual < PICReferenciaFinal - toleranciaPIC) { aumentarPresion(); return; }
  detenerMotor();
}

void mostrarPICMonitor() {
  if (millis() - ultimaImpresionPIC < intervaloMonitorPIC_ms) return;
  ultimaImpresionPIC = millis();

  Serial.print("PIC actual: ");
  Serial.print(presionActual, 2);

  if (estadoSistema == CONTROLANDO_PRESION) {
    Serial.print(" | Objetivo: "); Serial.print(PICObjetivo, 2);
  } else if (estadoSistema == MIDIENDO_DRENAJE) {
    float tiempoTranscurrido_s = (millis() - tiempoInicioDrenaje) / 1000.0f;
    Serial.print(" | PIC inicial: "); Serial.print(picInicialDrenaje, 2);
    Serial.print(" | Tiempo: "); Serial.print(tiempoTranscurrido_s, 1); Serial.print(" s");
  } else if (estadoSistema == AJUSTANDO_PIC_FINAL) {
    Serial.print(" | Referencia: "); Serial.print(PICReferenciaFinal, 2);
    Serial.print(" | PIC Final: "); Serial.print(PICFinal, 2);
  } else if (estadoSistema == PIC_FINAL_ALCANZADA) {
    Serial.print(" | PIC Final: "); Serial.print(PICFinal, 2);
  }
  Serial.println(" mmHg");
}

// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);

  // MOTOR, SWITCHES Y RELÉ
  pinMode(directionPin, OUTPUT);
  pinMode(stepPin, OUTPUT);
  digitalWrite(stepPin, LOW);
  pinMode(switchLeft, INPUT_PULLUP);
  pinMode(switchRight, INPUT_PULLUP);
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, RELAY_OFF);

  // SENSOR MPX10DP
  analogReadResolution(12);
  analogSetPinAttenuation(pinSensor, ADC_11db);

  // MPU6050
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  if (configurarMPU6050()) Serial.println("MPU6050 configurado correctamente");
  else Serial.println("ERROR MPU6050");

  // WI-FI AP
  WiFi.softAP(nombreWiFi, claveWiFi);
  Serial.println("\nRed Wi-Fi creada");
  Serial.print("Nombre: "); Serial.println(nombreWiFi);
  Serial.print("IP: "); Serial.println(WiFi.softAPIP());

  // WEBSOCKET
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  Serial.println("WebSocket puerto 5000\n");
  Serial.println("Esperando temperatura...");
}

// =====================================================
// LOOP PRINCIPAL
// =====================================================
void loop() {
  webSocket.loop();

  switch (estadoSistema) {
    case ESPERANDO_TEMPERATURA:
      detenerMotor();
      break;

    case MIDIENDO_ANGULO:
      detenerMotor();
      actualizarMPU6050();

      // Monitor de Roll cada 50ms
      static uint32_t ultimaImpresionRoll = 0;
      if (millis() - ultimaImpresionRoll >= 50) {
        ultimaImpresionRoll = millis();
        Serial.print("Roll: "); Serial.print(KalmanAngleRoll, 2); Serial.println(" °");
      }

      if (millis() - tiempoInicioMedicion >= tiempoEstabilizacion_ms) {
        anguloEstable = -KalmanAngleRoll;
        PICAngulo = calcularPICAngulo(anguloEstable);
        deltaPICT = calcularDeltaPICT(temperaturaPaciente);
        PICObjetivo = PICAngulo + deltaPICT;

        Serial.println("\n================================");
        Serial.print("Angulo: "); Serial.print(anguloEstable, 2); Serial.println(" °");
        Serial.print("Temperatura: "); Serial.print(temperaturaPaciente, 2); Serial.println(" °C");
        Serial.print("PIC por angulo: "); Serial.print(PICAngulo, 2); Serial.println(" mmHg");
        Serial.print("Delta PIC temp: "); Serial.print(deltaPICT, 2); Serial.println(" mmHg");
        Serial.print("PIC OBJETIVO: "); Serial.print(PICObjetivo, 2); Serial.println(" mmHg");
        Serial.println("================================");

        ultimaLecturaPIC = 0; ultimaImpresionPIC = 0; ultimoEnvioPIC = 0; nuevaPICDisponible = false;
        estadoSistema = CONTROLANDO_PRESION;
      }
      break;

    case CONTROLANDO_PRESION:
      actualizarPIC();
      mostrarPICMonitor();
      transmitirDatos();

      if (nuevaPICDisponible) {
        nuevaPICDisponible = false;
        controlarPIC();
      }
      generarPasosMotor();
      verificarSwitches();
      break;

    case MIDIENDO_DRENAJE:
      detenerMotor();
      actualizarPIC();
      mostrarPICMonitor();
      transmitirDatos();

      if (millis() - tiempoInicioDrenaje >= tiempoMedicionDrenaje_ms) {
        finalizarMedicionDrenaje();
      }
      break;

    case AJUSTANDO_PIC_FINAL:
      actualizarPIC();
      actualizarReferenciaPICFinal();
      mostrarPICMonitor();
      transmitirDatos();

      if (nuevaPICDisponible) {
        nuevaPICDisponible = false;
        controlarPICFinal();
      }
      generarPasosMotor();
      verificarSwitches();

      if (fabs(PICReferenciaFinal - PICFinal) < 0.01 && fabs(presionActual - PICFinal) <= toleranciaPIC) {
        detenerMotor();
        digitalWrite(relayPin, RELAY_OFF); // <-- AÑADIDO: Apaga el relé al lograr la PIC final
        
        Serial.println("\n================================");
        Serial.println("PIC FINAL ALCANZADA");
        Serial.print("Drenaje: "); Serial.print(drenaje_mL_h, 2); Serial.println(" mL/h");
        Serial.print("PIC final calculada: "); Serial.print(PICFinal, 2); Serial.println(" mmHg");
        Serial.print("PIC fisica: "); Serial.print(presionActual, 2); Serial.println(" mmHg");
        Serial.println("================================");

        estadoSistema = PIC_FINAL_ALCANZADA;
      }
      break;

    case PIC_FINAL_ALCANZADA:
      detenerMotor();
      actualizarPIC();
      mostrarPICMonitor();
      transmitirDatos();
      break;

    case RETORNANDO_A_INICIO:
      if (digitalRead(switchRight) == LOW) {
        detenerMotor();
        digitalWrite(relayPin, RELAY_OFF); // <-- AÑADIDO: Apaga el relé al finalizar el retorno
        
        Serial.println("\n================================");
        Serial.println("FINAL DE CARRERA DETECTADO");
        Serial.println("Motor DETENIDO | Rele APAGADO");
        Serial.println("Retorno completado.");
        Serial.println("================================");

        // --- SE LIBERA LA BANDERA ---
        listoParaNuevaSesion = true;

        reiniciarEscenario();
        break;
      }
      generarPasosMotor();
      break;
  }
}

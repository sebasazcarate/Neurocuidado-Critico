void setup() {

  Serial.begin(
    115200
  );


  pinMode(
    directionPin,
    OUTPUT
  );


  pinMode(
    stepPin,
    OUTPUT
  );


  digitalWrite(
    stepPin,
    LOW
  );


  pinMode(
    relayPin,
    OUTPUT
  );


  digitalWrite(
    relayPin,
    RELAY_OFF
  );


  pinMode(
    switchLeft,
    INPUT_PULLUP
  );


  pinMode(
    switchRight,
    INPUT_PULLUP
  );


  analogReadResolution(
    12
  );


  analogSetPinAttenuation(
    pinSensor,
    ADC_11db
  );


  Wire.begin(
    SDA_PIN,
    SCL_PIN
  );


  Wire.setClock(
    400000
  );


  if (
    !configurarMPU6050()
  ) {

    Serial.println(
      "Error al configurar MPU6050"
    );

  }

  else {

    Serial.println(
      "MPU6050 configurado correctamente"
    );
  }


  WiFi.softAP(
    "Neurocuidado Critico",
    "12345678"
  );


  Serial.println(
    "Red Wi-Fi generada: Neurocuidado Critico"
  );


  Serial.print(
    "IP del servidor: "
  );


  Serial.println(
    WiFi.softAPIP()
  );


  webSocket.begin();


  webSocket.onEvent(
    webSocketEvent
  );


  Serial.println(
    "Servidor WebSocket en puerto 5000"
  );


  tiempoInicioDrenaje =
    millis();
}


void loop() {


  webSocket.loop();


  if (
    !temperaturaRecibida
  ) {

    return;
  }


  actualizarMPU6050();


  evaluarDrenaje();


  actualizarPICObjetivo();


  actualizarPresion();


  if (
    presionDisponible
  ) {

    presionDisponible =
      false;


    controlarPresion();
  }


  generarPasosMotor();


  verificarFinalesDeCarrera();


  transmitirDatosWS();


  if (
    millis() -
    tiempoUltimaImpresion >=
    intervaloImpresion_ms
  ) {

    tiempoUltimaImpresion =
      millis();


    mostrarDatos();
  }
}

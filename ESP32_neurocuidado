void detenerMotor() {

  estadoMotor = MOTOR_DETENIDO;

  digitalWrite(
    stepPin,
    LOW
  );

  digitalWrite(
    relayPin,
    RELAY_OFF
  );
}


void moverDerecha() {


  if (
    digitalRead(switchRight)
    == LOW
  ) {

    detenerMotor();

    return;
  }


  if (
    estadoMotor !=
    MOTOR_DERECHA
  ) {

    estadoMotor =
      MOTOR_DERECHA;


    digitalWrite(
      directionPin,
      HIGH
    );


    digitalWrite(
      relayPin,
      RELAY_OFF
    );
  }
}


void moverIzquierda() {


  if (
    digitalRead(switchLeft)
    == LOW
  ) {

    detenerMotor();

    return;
  }


  if (
    estadoMotor !=
    MOTOR_IZQUIERDA
  ) {

    estadoMotor =
      MOTOR_IZQUIERDA;


    digitalWrite(
      directionPin,
      LOW
    );


    digitalWrite(
      relayPin,
      RELAY_ON
    );
  }
}


void aumentarPresion() {

  if (
    izquierdaAumentaPresion
  ) {

    moverIzquierda();

  }

  else {

    moverDerecha();

  }
}


void disminuirPresion() {

  if (
    izquierdaAumentaPresion
  ) {

    moverDerecha();

  }

  else {

    moverIzquierda();

  }
}


void generarPasosMotor() {

  if (
    estadoMotor ==
    MOTOR_DETENIDO
  ) {

    return;
  }


  uint32_t tiempoActual =
    micros();


  if (
    tiempoActual -
    tiempoUltimoStep >=
    intervaloCambioStep_us
  ) {

    tiempoUltimoStep =
      tiempoActual;


    estadoStep =
      !estadoStep;


    digitalWrite(
      stepPin,
      estadoStep
    );
  }
}


void verificarFinalesDeCarrera() {


  if (
    estadoMotor ==
    MOTOR_IZQUIERDA
    &&
    digitalRead(switchLeft)
    == LOW
  ) {

    detenerMotor();
  }


  if (
    estadoMotor ==
    MOTOR_DERECHA
    &&
    digitalRead(switchRight)
    == LOW
  ) {

    detenerMotor();
  }
}


void controlarPresion() {

  float limiteInferior =
    PICObjetivo -
    toleranciaPresion;


  float limiteSuperior =
    PICObjetivo +
    toleranciaPresion;


  if (
    presion_mmHg <
    limiteInferior
  ) {

    aumentarPresion();
  }


  else if (
    presion_mmHg >
    limiteSuperior
  ) {

    disminuirPresion();
  }


  else {

    detenerMotor();
  }
}


float obtenerAnguloEstable() {

  return KalmanAnglePitch;
}


void evaluarDrenaje() {

  if (
    millis() -
    tiempoInicioDrenaje >=
    deltaT_Drenaje_ms
  ) {

    float picFinalDrenaje =
      presion_mmHg;


    float deltaPIC =
      picInicialDrenaje -
      picFinalDrenaje;


    if (
      deltaPIC > 0
    ) {

      tasaDrenaje_ml_h =
        deltaPIC * 3.5;

    }

    else {

      tasaDrenaje_ml_h =
        0.0;
    }


    picInicialDrenaje =
      presion_mmHg;


    tiempoInicioDrenaje =
      millis();
  }
}


void actualizarPICObjetivo() {

  anguloEstable =
    obtenerAnguloEstable();


  float picBase =
    10.0
    +
    (
      anguloEstable *
      0.15
    )
    +
    (
      (
        temperaturaPaciente -
        36.5
      )
      *
      1.2
    );


  if (
    isnan(
      tasaDrenaje_ml_h
    )
  ) {


    PICObjetivo =
      picBase -
      5.0;
  }


  else if (
    tasaDrenaje_ml_h <= 0
  ) {


    PICObjetivo =
      picBase;
  }


  else if (
    tasaDrenaje_ml_h <= 20
  ) {


    PICObjetivo =
      picBase -
      2.0;
  }


  else {


    PICObjetivo =
      picBase -
      6.0;
  }


  if (
    PICObjetivo < 0
  ) {

    PICObjetivo = 0;
  }
}


bool escribirRegistroMPU(
  uint8_t registro,
  uint8_t valor
) {

  Wire.beginTransmission(
    MPU_ADDRESS
  );

  Wire.write(
    registro
  );

  Wire.write(
    valor
  );


  return
    Wire.endTransmission()
    == 0;
}


bool configurarMPU6050() {


  if (
    !escribirRegistroMPU(
      0x6B,
      0x00
    )
  ) {

    return false;
  }


  delay(100);


  if (
    !escribirRegistroMPU(
      0x1A,
      0x05
    )
  ) {

    return false;
  }


  if (
    !escribirRegistroMPU(
      0x1C,
      0x10
    )
  ) {

    return false;
  }


  if (
    !escribirRegistroMPU(
      0x1B,
      0x08
    )
  ) {

    return false;
  }


  return true;
}


bool leerMPU6050() {

  Wire.beginTransmission(
    MPU_ADDRESS
  );

  Wire.write(
    0x3B
  );


  if (
    Wire.endTransmission(false)
    != 0
  ) {

    return false;
  }


  if (
    Wire.requestFrom(
      MPU_ADDRESS,
      (uint8_t)14
    )
    != 14
  ) {

    return false;
  }


  int16_t AccXLSB =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  int16_t AccYLSB =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  int16_t AccZLSB =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  Wire.read();
  Wire.read();


  int16_t GyroX =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  int16_t GyroY =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  int16_t GyroZ =
    (
      (int16_t)Wire.read()
      << 8
    )
    |
    Wire.read();


  AccX =
    (float)AccXLSB /
    4096.0;


  AccY =
    (float)AccYLSB /
    4096.0;


  AccZ =
    (float)AccZLSB /
    4096.0;


  RateRoll =
    (float)GyroX /
    65.5;


  RatePitch =
    (float)GyroY /
    65.5;


  RateYaw =
    (float)GyroZ /
    65.5;


  AngleRoll =
    atan2(
      AccY,
      sqrt(
        AccX * AccX
        +
        AccZ * AccZ
      )
    )
    *
    180.0
    /
    PI;


  AnglePitch =
    -atan2(
      AccX,
      sqrt(
        AccY * AccY
        +
        AccZ * AccZ
      )
    )
    *
    180.0
    /
    PI;


  return true;
}


void kalman_1d(
  float &KalmanState,
  float &KalmanUncertainty,
  float KalmanInput,
  float KalmanMeasurement
) {


  KalmanState =
    KalmanState
    +
    tiempoMuestreoKalman
    *
    KalmanInput;


  KalmanUncertainty =
    KalmanUncertainty
    +
    tiempoMuestreoKalman
    *
    tiempoMuestreoKalman
    *
    16.0;


  float KalmanGain =
    KalmanUncertainty
    /
    (
      KalmanUncertainty
      +
      9.0
    );


  KalmanState =
    KalmanState
    +
    KalmanGain
    *
    (
      KalmanMeasurement
      -
      KalmanState
    );


  KalmanUncertainty =
    (
      1.0 -
      KalmanGain
    )
    *
    KalmanUncertainty;
}


void actualizarMPU6050() {

  if (
    micros() -
    tiempoUltimoMPU <
    intervaloMPU_us
  ) {

    return;
  }


  tiempoUltimoMPU +=
    intervaloMPU_us;


  if (
    !leerMPU6050()
  ) {

    return;
  }


  RateRoll -=
    RateCalibrationRoll;


  RatePitch -=
    RateCalibrationPitch;


  RateYaw -=
    RateCalibrationYaw;


  AngleRoll -=
    AngleCalibrationRoll;


  AnglePitch -=
    AngleCalibrationPitch;


  kalman_1d(
    KalmanAngleRoll,
    KalmanUncertaintyAngleRoll,
    RateRoll,
    AngleRoll
  );


  kalman_1d(
    KalmanAnglePitch,
    KalmanUncertaintyAnglePitch,
    RatePitch,
    AnglePitch
  );
}


void actualizarPresion() {

  if (
    micros() -
    tiempoUltimaMuestraPresion <
    intervaloMuestraPresion_us
  ) {

    return;
  }


  tiempoUltimaMuestraPresion +=
    intervaloMuestraPresion_us;


  sumaPresion_mV +=
    analogReadMilliVolts(
      pinSensor
    );


  contadorMuestrasPresion++;


  if (
    contadorMuestrasPresion >=
    muestrasPresion
  ) {

    float promedio_mV =
      sumaPresion_mV
      /
      (float)muestrasPresion;


    voltajeESP32 =
      promedio_mV /
      1000.0;


    voltajeCorregido =
      pendiente
      *
      voltajeESP32
      +
      intercepto;


    if (
      voltajeCorregido < 0
    ) {

      voltajeCorregido = 0;
    }


    presion_mmHg =
      voltajeCorregido
      *
      factor_mmHg_por_V;


    sumaPresion_mV = 0;

    contadorMuestrasPresion = 0;

    presionDisponible = true;
  }
}


void webSocketEvent(
  uint8_t num,
  WStype_t type,
  uint8_t * payload,
  size_t length
) {

  switch(type) {


    case WStype_DISCONNECTED:

      Serial.printf(
        "[%u] Cliente desconectado\n",
        num
      );

      conexionPCEstablecida =
        false;

      break;


    case WStype_CONNECTED:
    {

      IPAddress ip =
        webSocket.remoteIP(num);


      Serial.printf(
        "[%u] Conectado desde %d.%d.%d.%d\n",
        num,
        ip[0],
        ip[1],
        ip[2],
        ip[3]
      );


      conexionPCEstablecida =
        true;

      break;
    }


    case WStype_TEXT:
    {

      StaticJsonDocument<200>
        doc;


      DeserializationError error =
        deserializeJson(
          doc,
          payload
        );


      if (
        !error
        &&
        doc.containsKey(
          "TEMPERATURA"
        )
      ) {

        temperaturaPaciente =
          doc["TEMPERATURA"];


        temperaturaRecibida =
          true;


        Serial.printf(
          "Temperatura recibida: %.2f °C\n",
          temperaturaPaciente
        );
      }


      break;
    }


    default:

      break;
  }
}


void transmitirDatosWS() {

  if (
    !conexionPCEstablecida
  ) {

    return;
  }


  uint32_t tiempoActual =
    millis();


  if (
    tiempoActual -
    tiempoUltimoEnvioPC <
    intervaloEnvioPC_ms
  ) {

    return;
  }


  tiempoUltimoEnvioPC =
    tiempoActual;


  StaticJsonDocument<200>
    doc;


  doc["PIC"] =
    presion_mmHg;


  doc["ANGULO"] =
    anguloEstable;


  String jsonString;


  serializeJson(
    doc,
    jsonString
  );


  webSocket.broadcastTXT(
    jsonString
  );
}


